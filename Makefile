# VITA study: every number, table and figure of the paper is regenerated by these targets.
PY ?= python3
JOBS ?= 2

.PHONY: setup data oracle baselines anchors train evaluate ablations transfer assets paper test all clean-paper

setup:
	$(PY) -m pip install -r requirements.txt

data:
	$(PY) scripts/run_pipeline.py data

oracle: data
	$(PY) scripts/run_pipeline.py oracle --jobs $(JOBS)

anchors: oracle
	$(PY) scripts/run_pipeline.py anchors --jobs $(JOBS)

baselines: oracle
	$(PY) scripts/run_pipeline.py dev-baselines --jobs $(JOBS)
	$(PY) scripts/run_pipeline.py baselines --jobs $(JOBS)

train: anchors
	$(PY) scripts/run_pipeline.py train --jobs $(JOBS)

evaluate: train baselines
	$(PY) scripts/run_pipeline.py evaluate --jobs $(JOBS)

ablations: train
	$(PY) scripts/run_pipeline.py ablations --jobs $(JOBS)

transfer: evaluate
	@echo "scenario transfer is part of 'evaluate' (VITA trained at 150 EUR/t, applied at 80 and 250 EUR/t)"

# regenerate CSV files, tables and macros from cached results (minutes)
assets:
	$(PY) scripts/make_assets.py
	$(PY) scripts/check_numbers.py

paper:
	cd paper && latexmk -pdf -interaction=nonstopmode -halt-on-error main.tex

test:
	$(PY) -m pytest -q tests

all: data oracle anchors baselines train evaluate ablations assets paper

clean-paper:
	cd paper && latexmk -C main.tex
